# ============================================
# Termdown dengan beep di detik terakhir (Zsh)
# ============================================
AUDIO="$HOME/Audio/done.mp3"

td() {
    local duration=$1
    local beep_at=${2:-3}
    local title=${3:-"TIMER"}
    
    # Parse duration
    local total=0
    if [[ $duration =~ '([0-9]+)h' ]]; then
        total=$((total + match[1] * 3600))
    fi
    if [[ $duration =~ '([0-9]+)m' ]]; then
        total=$((total + match[1] * 60))
    fi
    if [[ $duration =~ '([0-9]+)s' ]]; then
        total=$((total + match[1]))
    fi
    
    local wait=$((total - beep_at))
    
    # Background beeper (SILENT)
    (
        sleep $wait
        for ((i=beep_at; i>0; i--)); do
            mpv --no-video --no-terminal --really-quiet --volume=70 "$AUDIO" \
                >/dev/null 2>&1 &
            sleep 1
        done
        mpv --no-video --no-terminal --volume=100 "$AUDIO" >/dev/null 2>&1
        notify-send -u critical "⏰ Timer Complete!" "$title done"
    ) >/dev/null 2>&1 &
    
    disown  # Lepas dari job control (hilangkan notif [done])
    
    termdown "$duration" -t "$title"
}

