{
    // ====================================
    // WAYBAR CONFIG - OPTIMIZED v2
    // Black & White Theme
    // Improvements: Better intervals, CPU module, auto battery detect
    // ====================================
    
    "layer": "top",
    "position": "top",
    "height": 32,
    "spacing": 6,
    
    "modules-left": [
        "hyprland/workspaces",
        "cpu",
        "temperature",
        "memory"
    ],
    
    "modules-center": [
        "clock"
    ],
    
    "modules-right": [
        "network",
        "bluetooth",
        "wireplumber",
        "battery",
        "hyprland/language",
        "idle_inhibitor",
        "tray"
    ],
    
    // ====================================
    // WORKSPACES
    // ====================================
    
    "hyprland/workspaces": {
        "format": "{name}",
        "on-click": "activate",
        "format-icons": {
            "active": "●",
            "default": "○",
            "urgent": "!"
        },
        "sort-by-number": true,
        "persistent-workspaces": {
            "1": [],
            "2": [],
            "3": [],
            "4": [],
            "5": []
        }
    },
    
    // ====================================
    // CLOCK
    // ====================================
    
    "clock": {
        "interval": 1,
        "format": "{:%d/%m/%Y | %H:%M:%S}",
        "format-alt": "{:%A, %d %B %Y}",
        "tooltip-format": "<tt><small>{calendar}</small></tt>",
        "calendar": {
            "mode": "month",
            "format": {
                "months": "<span color='#ffffff'><b>{}</b></span>",
                "days": "<span color='#cccccc'>{}</span>",
                "weeks": "<span color='#999999'>{}</span>",
                "weekdays": "<span color='#ffffff'>{}</span>",
                "today": "<span color='#ffffff'><b><u>{}</u></b></span>"
            }
        }
    },
    
    // ====================================
    // CPU
    // ====================================
    
    "cpu": {
        "interval": 10,
        "format": "󰻠 {usage}%",
        "format-alt": "󰻠 {avg_frequency}GHz",
        "tooltip-format": "CPU Usage: {usage}%\nLoad Average: {load}",
        "on-click": "alacritty -e htop",
        "states": {
            "warning": 70,
            "critical": 90
        }
    },
    
    // ====================================
    // AUDIO
    // ====================================
    
    "wireplumber": {
        "format": "{icon} {volume}%",
        "format-muted": "󰖁 MUTE",
        "format-icons": ["󰕿", "󰖀", "󰕾"],
        "max-volume": 100,
        "scroll-step": 5,
        "on-click": "pavucontrol",
        "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"
    },
    
    // ====================================
    // BATTERY
    // ====================================
    
    "battery": {
        "interval": 30,
        "states": {
            "warning": 30,
            "critical": 15
        },
        "format": "{icon} {capacity}%",
        "format-charging": "󰂄 {capacity}%",
        "format-plugged": "󰚥 {capacity}%",
        "format-full": "󰁹 {capacity}%",
        "format-icons": ["󰂎", "󰁺", "󰁾", "󰂀", "󰁹"],
        "tooltip-format": "{timeTo}\nCapacity: {capacity}%\nPower: {power}W"
    },
    
    // ====================================
    // MEMORY
    // ====================================
    
    "memory": {
        "interval": 10,
        "format": "  {percentage}%",
        "format-alt": "  {used:0.1f}G/{total:0.1f}G",
        "tooltip-format": "RAM: {used:0.1f}G / {total:0.1f}G ({percentage}%)\nSwap: {swapUsed:0.1f}G / {swapTotal:0.1f}G ({swapPercentage}%)",
        "states": {
            "warning": 70,
            "critical": 90
        }
    },
    
    // ====================================
    // TEMPERATURE
    // ====================================
    
    "temperature": {
        "interval": 10,
        "format": " {temperatureC}°C",
        "critical-threshold": 80,
        "format-critical": " {temperatureC}°C",
        "tooltip-format": "Temperature: {temperatureC}°C"
    },
    
    // ====================================
    // NETWORK
    // ====================================
    
    "network": {
        "interval": 10,
        "format": "{icon}",
        "format-ethernet": "󰈀",
        "format-wifi": "{icon}",
        "format-disconnected": "󰖪",
        "format-icons": ["󰤯", "󰤟", "󰤢", "󰤥", "󰤨"],
        "tooltip-format-wifi": "{essid}\nSignal: {signalStrength}%\nIP: {ipaddr}\nSpeed: {bandwidthDownBits}",
        "tooltip-format-ethernet": "Ethernet\nIP: {ipaddr}\nSpeed: {bandwidthDownBits}",
        "tooltip-format-disconnected": "Disconnected",
        "on-click": "nm-connection-editor"
    },
    
    // ====================================
    // BLUETOOTH
    // ====================================
    
    "bluetooth": {
        "format": "󰂯",
        "format-disabled": "󰂲",
        "format-off": "󰂲",
        "format-connected": "󰂱 {num_connections}",
        "tooltip-format": "{controller_alias}\t{controller_address}\nStatus: {status}",
        "tooltip-format-connected": "{controller_alias}\t{controller_address}\nStatus: {status}\n\n{device_enumerate}",
        "tooltip-format-enumerate-connected": "{device_alias}\t{device_address}",
        "tooltip-format-enumerate-connected-battery": "{device_alias}\t{device_address}\tBattery: {device_battery_percentage}%",
        "on-click": "blueman-manager"
    },
    
    // ====================================
    // LANGUAGE
    // ====================================
    
    "hyprland/language": {
        "format": "  {}",
        "format-en": "EN",
        "format-id": "ID",
        "keyboard-name": "at-translated-set-2-keyboard"
    },
    
    // ====================================
    // IDLE INHIBITOR
    // ====================================
    
    "idle_inhibitor": {
        "format": "{icon}",
        "format-icons": {
            "activated": "󰅾",
            "deactivated": "󰾪"
        },
        "tooltip-format-activated": "Idle inhibitor: ON\nScreen will not turn off",
        "tooltip-format-deactivated": "Idle inhibitor: OFF\nScreen will turn off normally"
    },
    
    // ====================================
    // TRAY
    // ====================================
    
    "tray": {
        "icon-size": 16,
        "spacing": 12,
        "show-passive-items": true
    }
}
