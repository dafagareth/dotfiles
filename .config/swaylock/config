# ~/.config/swaylock/config
# Minimalist grayscale theme matching Hyprland

daemonize
show-failed-attempts
clock
timestr=%H:%M
datestr=%a, %d %B

# Background
color=000000

# Text
text-color=ffffff
text-caps-lock-color=ffffff
font=JetBrains Mono

# Inside ring
inside-color=00000099
inside-clear-color=00000099
inside-caps-lock-color=00000099
inside-ver-color=00000099
inside-wrong-color=ff000099

# Ring
ring-color=ffffffcc
ring-clear-color=ffffff66
ring-caps-lock-color=ffff0066
ring-ver-color=00ff0066
ring-wrong-color=ff000066

# Line separator
line-color=00000000
line-clear-color=00000000
line-caps-lock-color=00000000
line-ver-color=00000000
line-wrong-color=00000000

# Separator color
separator-color=00000000

# Indicator
indicator-radius=100
indicator-thickness=10

# Backspace highlight
bs-hl-color=ffffff
key-hl-color=ffffff

# Effects
fade-in=0.2
grace=2
grace-no-mouse
grace-no-touch