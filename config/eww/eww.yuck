;; ══════════════════════════════════════════════════════════════
;;  eww — popup Media & Volume untuk Waybar (dipicu KLIK modul)
;;  Tema GitHub Dark, senada kitty/waybar/wofi.
;; ══════════════════════════════════════════════════════════════

;; ─── Sumber data ──────────────────────────────────────────────

(deflisten media
  :initial '{"status":"Stopped","title":"Tidak ada media","artist":"","player":"","art":"","progress":0}'
  "$HOME/.config/eww/scripts/media-info.sh")

;; cava hanya benar-benar berjalan saat popup media terbuka (lihat skripnya)
(deflisten cava
  :initial "▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁"
  "$HOME/.config/eww/scripts/cava-bars.sh")

(defpoll vol
  :interval "1s"
  :initial '{"master":0,"master_muted":false,"mic":0,"mic_muted":false,"apps":[]}'
  "$HOME/.config/eww/scripts/volume-info.sh")


;; ─── Backdrop ─────────────────────────────────────────────────
;; Lapisan transparan selebar layar, DIBUKA DI BAWAH popup. Popup eww tidak
;; punya event "focus lost", jadi inilah satu-satunya cara menutupnya saat
;; kamu klik di sembarang tempat. Klik di sini -> semua popup ditutup.

(defwidget backdrop-area []
  (eventbox :onclick "$HOME/.config/eww/scripts/popup.sh close"
    (box :class "backdrop")))

(defwindow backdrop
  :monitor 0
  :geometry (geometry :x "0px" :y "0px" :width "100%" :height "100%")
  :stacking "overlay"
  :exclusive false
  :focusable false
  (backdrop-area))


;; ─── Popup MEDIA ──────────────────────────────────────────────

(defwidget media-popup []
  (box :class "popup" :orientation "h" :space-evenly false :spacing 14
    ;; album art (kosong -> kotak polos, tidak error)
    (box :class "art" :style "background-image: url('${media.art}');")

    (box :orientation "v" :space-evenly false :spacing 3 :hexpand true
      (label :class "title"  :halign "start" :limit-width 30 :text {media.title})
      (label :class "artist" :halign "start" :limit-width 36
             :text {media.artist == "" ? media.player
                                       : "${media.artist} · ${media.player}"})

      ;; visualizer cava (live)
      (label :class "cava" :halign "start" :text cava)

      (progress :class "prog" :orientation "h" :value {media.progress})

      (box :class "ctl" :orientation "h" :space-evenly false :spacing 14 :halign "center"
        (button :class "btn"          :onclick "playerctl previous"   "󰒮")
        (button :class "btn btn-main" :onclick "playerctl play-pause"
                {media.status == "Playing" ? "󰏤" : "󰐊"})
        (button :class "btn"          :onclick "playerctl next"       "󰒭")))))

(defwindow media
  :monitor 0
  :geometry (geometry :x "0px" :y "8px" :width "440px" :anchor "top center")
  :stacking "overlay"
  :exclusive false
  :focusable false
  (media-popup))


;; ─── Popup VOLUME ─────────────────────────────────────────────

(defwidget vol-row [icon name value onchange muted]
  (box :class "vrow" :orientation "h" :space-evenly false :spacing 10
    (label :class {muted ? "vicon muted" : "vicon"} :text icon)
    (box :orientation "v" :space-evenly false :hexpand true
      (label :class "vname" :halign "start" :limit-width 26 :text name)
      (scale :class "vslider" :min 0 :max 101 :value value :onchange onchange))
    (label :class "vpct" :text "${value}%")))

(defwidget volume-popup []
  (box :class "popup vpopup" :orientation "v" :space-evenly false :spacing 10

    (label :class "phead" :halign "start" :text "Volume")

    (vol-row :icon {vol.master_muted ? "󰖁" : "󰕾"}
             :name "Speaker"
             :value {vol.master}
             :muted {vol.master_muted}
             :onchange "wpctl set-volume @DEFAULT_AUDIO_SINK@ {}%")

    (vol-row :icon {vol.mic_muted ? "󰍭" : "󰍬"}
             :name "Mikrofon"
             :value {vol.mic}
             :muted {vol.mic_muted}
             :onchange "wpctl set-volume @DEFAULT_AUDIO_SOURCE@ {}%")

    (box :class "sep")

    (label :class "phead" :halign "start" :text "Per aplikasi")

    ;; tak ada app yang bersuara
    (label :class "empty" :halign "start"
           :visible {arraylength(vol.apps) == 0}
           :text "Tak ada aplikasi yang bersuara")

    ;; satu slider per aplikasi yang sedang bunyi
    (box :orientation "v" :space-evenly false :spacing 6
         :visible {arraylength(vol.apps) > 0}
      (for app in {vol.apps}
        (vol-row :icon "󰋋"
                 :name {app.name}
                 :value {app.vol}
                 :muted false
                 :onchange "pactl set-sink-input-volume ${app.id} {}%")))))

(defwindow volume
  :monitor 0
  :geometry (geometry :x "8px" :y "8px" :width "380px" :anchor "top right")
  :stacking "overlay"
  :exclusive false
  :focusable false
  (volume-popup))
