// fastfetch — GitHub Dark (key biru #58a6ff)
// Jalankan: fastfetch
{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "auto",
        "padding": { "top": 1, "right": 3 }
    },
    "display": {
        "separator": "  "
    },
    "modules": [
        "break",
        { "type": "title", "keyColor": "38;2;88;166;255" },
        { "type": "separator", "string": "─" },
        { "type": "os", "key": " OS", "keyColor": "38;2;88;166;255" },
        { "type": "kernel", "key": " Kernel", "keyColor": "38;2;88;166;255" },
        { "type": "uptime", "key": "󰅐 Uptime", "keyColor": "38;2;88;166;255" },
        { "type": "packages", "key": "󰏖 Packages", "keyColor": "38;2;88;166;255" },
        { "type": "wm", "key": " WM", "keyColor": "38;2;88;166;255" },
        { "type": "shell", "key": " Shell", "keyColor": "38;2;88;166;255" },
        { "type": "terminal", "key": " Terminal", "keyColor": "38;2;88;166;255" },
        "break",
        { "type": "cpu", "key": " CPU", "keyColor": "38;2;88;166;255" },
        { "type": "gpu", "key": "󰢮 GPU", "keyColor": "38;2;88;166;255" },
        { "type": "memory", "key": " Memory", "keyColor": "38;2;88;166;255" },
        { "type": "disk", "key": " Disk", "keyColor": "38;2;88;166;255" },
        "break",
        { "type": "colors", "symbol": "circle" }
    ]
}
